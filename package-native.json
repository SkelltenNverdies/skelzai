{
  "name": "skelzai",
  "version": "3.2.0",
  "private": true,
  "description": "SkelzAI — Intelligent Chat Assistant (Native Android App)",
  "author": "Gabriel Arjun Pangestu",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "start": "vercel dev",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npx cap sync android && npx cap open android",
    "android:dev": "npx cap run android",
    "android:build": "cd android && ./gradlew assembleRelease",
    "android:debug": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/clipboard": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0"
  },
  "engines": {
    "node": ">=18.x"
  }
}
