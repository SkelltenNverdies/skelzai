# SkelzAI Environment Variables — Copy to Vercel Project Settings > Environment Variables
# Atau simpan sebagai .env lokal untuk `vercel dev` (JANGAN commit file .env ke git!)

# SkelzAI / Qwen (DashScope) — wajib untuk model SkelzAI Turbo/Plus/Max
QWEN_API_KEY=your_qwen_api_key_here

# Groq Cloud — wajib untuk model Llama 3.3 70B & Llama 3.1 8B
GROQ_API_KEY=your_groq_api_key_here

# BluesMinds — wajib untuk model GLM 4.6 (token unlimited)
BLUEMINDS_API_KEY=your_blueminds_api_key_here
