# SkelzAI Environment Variables — Copy to Vercel Project Settings > Environment Variables
# Atau simpan sebagai .env lokal untuk `vercel dev` (JANGAN commit file .env ke git!)

# SkelzAI / Qwen (DashScope) — wajib untuk model SkelzAI Turbo/Plus/Max
QWEN_API_KEY=your_qwen_api_key_here

# Groq Cloud — wajib untuk model Llama 3.3 70B & Llama 3.1 8B (Groq)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter — untuk NVIDIA Nemotron 3 + Nemotron Nano 12B VL + Nemotron Omni 30B (gratis)
# Opsional — ada fallback API key bawaan, tapi disarankan set punya sendiri
# Daftar di: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini — untuk Gemini 2.5 Pro/Flash, 2.0 Flash/Lite (gratis + vision)
# Opsional — ada fallback API key bawaan, tapi disarankan set punya sendiri
# Daftar di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Models — untuk GPT-4o mini (gratis dengan GitHub PAT)
# Opsional — ada fallback API key bawaan, tapi disarankan set punya sendiri
# Buat token di: https://github.com/settings/tokens (fine-grained, read-only)
GITHUB_TOKEN=your_github_pat_here
