# SkelzAI Environment Variables — Copy to Vercel Project Settings > Environment Variables
# Atau simpan sebagai .env lokal untuk `vercel dev` (JANGAN commit file .env ke git!)

# SkelzAI / Qwen (DashScope) — wajib untuk model SkelzAI Turbo/Plus/Max
QWEN_API_KEY=your_qwen_api_key_here

# Groq Cloud — wajib untuk model Llama 3.3 70B & Llama 3.1 8B (Groq)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter — untuk NVIDIA Nemotron 3 + Nemotron Nano 12B VL + Nemotron Omni 30B (gratis)
# Opsional — ada fallback API key bawaan, tapi disarankan set punya sendiri
# Daftar di: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini — untuk Gemini 2.5 Pro/Flash, 2.0 Flash/Lite (gratis + vision)
# Opsional — ada fallback API key bawaan, tapi disarankan set punya sendiri
# Daftar di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# GITHUB TOKEN — WAJIB untuk GPT-4o mini
# ============================================================
# GitHub auto-revoke PAT yang di-embed di kode (fitur secret scanning).
# Karena itu PAT TIDAK BOLEH di-embed di api/chat.js — harus via env var.
#
# Cara setup:
# 1. Buka https://github.com/settings/tokens?type=beta (fine-grained PAT)
#    ATAU https://github.com/settings/tokens/new (classic PAT)
# 2. Classic PAT: centang scope "repo" (untuk akses GitHub Models)
#    Fine-grained PAT: Resource owner = diri sendiri, Repository access = All,
#                      Permissions → Models = Read-only
# 3. Set expiration: 90 days (recommended) atau Custom
# 4. Generate token, copy mulai dari "ghp_" (classic) atau "github_pat_" (fine-grained)
# 5. Di Vercel dashboard → Project Settings → Environment Variables:
#    Key:   GITHUB_TOKEN
#    Value: ghp_xxxxxxxxxxxx
#    Environment: Production, Preview, Development (centang semua)
# 6. Click Save, lalu Redeploy project
#
# Setelah PAT di env var, gpt-4o mini akan langsung jalan.
GITHUB_TOKEN=your_github_pat_here

# NVIDIA NIM — untuk DeepSeek V4 Pro/Flash, Qwen3.5, Llama 3.2 Vision, Kimi K2.6, GLM 5.2, dll (gratis 1000 credits)
# Opsional — ada fallback API key bawaan, tapi disarankan set punya sendiri
# Daftar di: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# AIHubMix — untuk model AIHubMix free + image generation
# Opsional — ada fallback API key bawaan
AIHUBMIX_API_KEY=your_aihubmix_api_key_here

# Vercel KV (Redis) — WAJIB untuk login & auto-sync chat antar device
# Setup: https://vercel.com/dashboard/stores → Create Database → KV
# Lalu link ke project: vercel kv link
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token
